# Panacea OS local environment template
# Safe placeholder file only. Do not commit real secrets, bearer tokens, JWTs, certificates, private keys, or patient data.

PANACEA_RUNTIME_MODE=local
PANACEA_PUBLIC_WEB_URL=http://localhost:5174
PANACEA_API_PUBLIC_BASE_URL=http://localhost:18095
PANACEA_CORS_ALLOWED_ORIGINS=http://localhost:5174
PANACEA_JWT_ISSUER=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_JWT_AUDIENCE=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
POSTGRES_HOST=localhost
POSTGRES_PORT=55433
POSTGRES_DB=panacea_runtime
POSTGRES_USER=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
POSTGRES_PASSWORD=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_BACKUP_DIR=/backups/panacea
PANACEA_LOG_LEVEL=info

# Foundation provider contract. Values must point to the approved external provider before live use.
PANACEA_FOUNDATION_URL=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_FOUNDATION_JWT_ISSUER=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_FOUNDATION_JWKS_URL=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_FOUNDATION_AUDIT_APPEND_PATH=/api/v1/audit-records
PANACEA_FOUNDATION_POLICY_EVALUATION_PATH=/api/v1/policy/evaluate
PANACEA_FOUNDATION_HEALTH_PATH=/health
PANACEA_FOUNDATION_READY_PATH=/ready
PANACEA_FOUNDATION_METRICS_PATH=/metrics
PANACEA_FOUNDATION_TIMEOUT_MS=3000
PANACEA_FOUNDATION_RETRY_ATTEMPTS=2
PANACEA_FOUNDATION_RETRY_BACKOFF_MS=250
PANACEA_FOUNDATION_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
PANACEA_FOUNDATION_CIRCUIT_BREAKER_RESET_MS=30000

# Service base URLs exposed through the pilot reverse proxy.
PANACEA_SERVICE_AUTONOMOUS_HEALTHCARE_INTELLIGENCE_URL=http://localhost:18094/api/v4/autonomous-healthcare-intelligence
PANACEA_SERVICE_GLOBAL_COMMAND_INTELLIGENCE_URL=http://localhost:18095/api/v4/global-command-intelligence
PANACEA_SERVICE_GLOBAL_WORKFORCE_URL=http://localhost:18141/api/v3/global-workforce
PANACEA_SERVICE_GLOBAL_LEGAL_GOVERNANCE_URL=http://localhost:18142/api/v3/global-legal-governance
PANACEA_SERVICE_GLOBAL_CUSTOMER_SUCCESS_URL=http://localhost:18143/api/v3/global-customer-success
PANACEA_SERVICE_GLOBAL_PRODUCT_MANAGEMENT_URL=http://localhost:18144/api/v3/global-product-management
PANACEA_SERVICE_GLOBAL_COMPLIANCE_URL=http://localhost:18145/api/v3/global-compliance
PANACEA_SERVICE_GLOBAL_AI_ASSURANCE_URL=http://localhost:18146/api/v3/global-ai-assurance
PANACEA_SERVICE_GLOBAL_PRIVACY_URL=http://localhost:18147/api/v3/global-privacy
