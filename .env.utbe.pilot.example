# Panacea OS UTBE pilot environment template
# Safe placeholder file only. Do not commit real secrets, bearer tokens, JWTs, certificates, private keys, or patient data.

PANACEA_RUNTIME_MODE=pilot
PANACEA_PUBLIC_WEB_URL=https://panacea.utbe.ai
PANACEA_API_PUBLIC_BASE_URL=https://api.panacea.utbe.ai
PANACEA_CORS_ALLOWED_ORIGINS=https://panacea.utbe.ai
PANACEA_JWT_ISSUER=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_JWT_AUDIENCE=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=panacea
POSTGRES_USER=panacea
POSTGRES_PASSWORD=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_BACKUP_DIR=/var/backups/panacea
PANACEA_LOG_LEVEL=info

# Foundation provider contract. Values must point to the approved external provider before live use.
PANACEA_FOUNDATION_URL=https://foundation.utbe.ai
PANACEA_FOUNDATION_JWT_ISSUER=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_FOUNDATION_JWKS_URL=https://foundation.utbe.ai/.well-known/jwks.json
PANACEA_FOUNDATION_AUDIT_APPEND_PATH=/api/v1/audit-records
PANACEA_FOUNDATION_POLICY_EVALUATION_PATH=/api/v1/policy/evaluate
PANACEA_FOUNDATION_HEALTH_PATH=/health
PANACEA_FOUNDATION_READY_PATH=/ready
PANACEA_FOUNDATION_METRICS_PATH=/metrics
PANACEA_FOUNDATION_TIMEOUT_MS=3000
PANACEA_FOUNDATION_RETRY_ATTEMPTS=2
PANACEA_FOUNDATION_RETRY_BACKOFF_MS=250
PANACEA_FOUNDATION_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
PANACEA_FOUNDATION_CIRCUIT_BREAKER_RESET_MS=30000

# Foundation authentication provider. Values must be supplied outside Git.
PANACEA_FOUNDATION_AUTH_AUDIENCE=panacea-os
PANACEA_FOUNDATION_AUTH_PRIVATE_KEY_PEM=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_FOUNDATION_AUTH_PUBLIC_KEY_PEM=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_FOUNDATION_AUTH_KEY_ID=REPLACE_WITH_REAL_VALUE_OUTSIDE_GIT
PANACEA_FOUNDATION_USERS_FILE=/etc/panacea/foundation-auth/foundation-users.json
PANACEA_FOUNDATION_AUTH_REFRESH_TOKEN_STORE_FILE=/var/lib/panacea/foundation-refresh-sessions.json
PANACEA_FOUNDATION_AUTH_CORS_ORIGIN=https://panacea.utbe.ai
PANACEA_FOUNDATION_AUTH_PORT=8080

# Service base URLs exposed through the UTBE pilot reverse proxy.
PANACEA_SERVICE_AUTONOMOUS_HEALTHCARE_INTELLIGENCE_URL=https://api.panacea.utbe.ai/api/v4/autonomous-healthcare-intelligence
PANACEA_SERVICE_GLOBAL_COMMAND_INTELLIGENCE_URL=https://api.panacea.utbe.ai/api/v4/global-command-intelligence
PANACEA_SERVICE_GLOBAL_WORKFORCE_URL=https://api.panacea.utbe.ai/api/v3/global-workforce
PANACEA_SERVICE_GLOBAL_LEGAL_GOVERNANCE_URL=https://api.panacea.utbe.ai/api/v3/global-legal-governance
PANACEA_SERVICE_GLOBAL_CUSTOMER_SUCCESS_URL=https://api.panacea.utbe.ai/api/v3/global-customer-success
PANACEA_SERVICE_GLOBAL_PRODUCT_MANAGEMENT_URL=https://api.panacea.utbe.ai/api/v3/global-product-management
PANACEA_SERVICE_GLOBAL_COMPLIANCE_URL=https://api.panacea.utbe.ai/api/v3/global-compliance
PANACEA_SERVICE_GLOBAL_AI_ASSURANCE_URL=https://api.panacea.utbe.ai/api/v3/global-ai-assurance
PANACEA_SERVICE_GLOBAL_PRIVACY_URL=https://api.panacea.utbe.ai/api/v3/global-privacy
